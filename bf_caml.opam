# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
depends: [
  "dune" {>= "3.23"}
  "ocaml" {>= "5.0" & < "6"}
  "hardcaml" {= "v0.17.1"}
  "ppx_hardcaml" {= "v0.17.1"}
  "linenoise"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
